<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="5dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginHorizontal="2dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="2dp">
        <RelativeLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/main_card">
            <ImageView
                android:id="@+id/image"
                android:background="#cccccc"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#181818"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="15dp"
                android:text="sam"
                android:lines="1"
                android:layout_below="@+id/image"/>
            <TextView
                android:textSize="16sp"
                android:id="@+id/session_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session 2018-19"
                android:layout_below="@+id/name"
                android:layout_alignStart="@+id/name"/>
            <TextView
                android:textSize="15sp"
                android:id="@+id/placed_text"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="15dp"
                android:text="Placed In Wipro"
                android:layout_below="@+id/session_text"
                android:layout_alignStart="@+id/session_text"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
